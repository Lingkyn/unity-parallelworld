%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 37837b860e87bdc4cbed6426153030bd, type: 3}
  m_Name: InteractableDatabase
  m_EditorClassIdentifier: 
  _entries:
  - entryId: bottle
    promptText: Press [X] to turn on light
  - entryId: mirror
    promptText: Click the light to move
  - entryId: photo
    promptText: Collect the photo
  - entryId: dialogue coffee
    promptText: "This is the coffee I bought to stay up late and finish my work\u2026
      Do I really have to pour it away? "
  - entryId: dialogue coffee end
    promptText: "Alright\u2026 but I still feel a little uneasy. "
  - entryId: dialogue file
    promptText: "These are all completed work files. I just haven\u2019t had time
      to organize them. "
  - entryId: dialogue plug
    promptText: "Do I need to unplug it? I won\u2019t be asleep for long\u2014I was
      planning to get more work done when I wake up. "
  - entryId: dialogue paper
    promptText: "This is my mid-year performance review. I was forced to take the
      C rating for the team, and I\u2019ve felt guilty ever since. I kept it to remind
      myself to do better. "
  - entryId: dialogue plug end
    promptText: "Alright\u2026 but what if there are files that haven\u2019t been
      saved? "
  - entryId: dialogue paper end
    promptText: 'Why do I always end up with the worst evaluation? '
  - entryId: L2 coffee
    promptText: Only push when shadow overlaps object.
  - entryId: L2 dialogue anxiety1
    promptText: "Heart of Anxiety? I should destroy it\u2026 I can\u2019t keep getting
      overwhelmed by anxiety so easily. "
  - entryId: L2 dialogue anxiety2
    promptText: The coffee is poisonous.
  - entryId: L2 pappercutter
    promptText: Try cutting the paper with a knife
